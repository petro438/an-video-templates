ANTHROPIC_API_KEY=sk-ant-...

# Optional — only needed for `npm run broll` (Pexels b-roll search)
# Get a free key at https://www.pexels.com/api/
PEXELS_API_KEY=

# Optional — only needed for `npm run broll:yt` (YouTube b-roll search)
# Enable YouTube Data API v3 at console.cloud.google.com
YOUTUBE_API_KEY=
